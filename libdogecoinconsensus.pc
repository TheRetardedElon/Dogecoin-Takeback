prefix=/usr/local
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: Dogecoin Core consensus library
Description: Library for the Dogecoin consensus protocol.
Version: 1.14.100
Libs: -L${libdir} -ldogecoinconsensus
Cflags: -I${includedir}
Requires.private: libcrypto
